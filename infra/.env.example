# Скопируй в infra/.env (install.sh генерирует автоматически). Секреты: `openssl rand -hex 32`.

# Домен панели (Caddy выпустит сертификат Let's Encrypt)
PANEL_DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com

# Тег образа api. install.sh собирает образ на сервере из git (тег = commit), GHCR — позже
NODESERVICE_VERSION=latest

# База данных
POSTGRES_PASSWORD=change-me

# Ключи приложения
APP_SECRET=change-me            # подпись cookie/CSRF/токенов, hex 64
ENCRYPTION_KEY=change-me        # AES-256-GCM для секретов (TOTP, токены), hex 64
ENCRYPTION_KEY_VERSION=1        # версия ключа — для ротации с re-encrypt
PASSWORD_PEPPER=change-me       # pepper argon2, hex 32–128; без него выводится из APP_SECRET

# Сроки хранения (дней): записи веб-терминала, запуски обслуживания с логами, решённые инциденты.
# Чистка ночью в 03:47. Журнал хранится помесячно: AUDIT_RETENTION_MONTHS (по умолчанию 12).
# TERMINAL_RETENTION_DAYS=90
# MAINTENANCE_RETENTION_DAYS=90
# INCIDENTS_RETENTION_DAYS=365
# NOTIFICATIONS_RETENTION_DAYS=30

# Запасной кэш иконок провайдеров, когда сайт закрыт защитой или без favicon. Шаблон с {host};
# пустая строка — выключить. По умолчанию — Google (наружу уходит только хост провайдера).
# PROVIDER_ICON_FALLBACK_URL=https://www.google.com/s2/favicons?sz=64&domain={host}
