{
	email {$ACME_EMAIL}
	servers {
		# h1 h2 h3; без h3, если UDP 443 на сервере занят (PANEL_PROTOCOLS в compose.yaml).
		protocols {$PANEL_PROTOCOLS}
	}
}

# Домен панели; на ноде с VPN — с портом (panel.example.com:8443).
{$PANEL_SITE} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API и SSE (живая лента журнала) — всё в api.
	# flush_interval -1 отключает буферизацию, иначе SSE «слипается».
	handle /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
			header_up X-Real-IP {remote_host}
		}
	}

	# Статика SPA отдаётся тем же образом api (dist/public), fallback на index.html внутри.
	handle {
		reverse_proxy api:3000
	}
}
